MDC_HTTP_PORT=18081
MDC_HTTPS_PORT=18443
MDC_DB_NAME=medical_data_center
MDC_DB_USERNAME=mdc_app
MDC_DB_PASSWORD=replace-with-strong-db-password
REDIS_PASSWORD=replace-with-strong-redis-password
MDC_JWT_SECRET=replace-with-32-byte-plus-secret
MDC_JWT_ACTIVE_KID=mdc-k2
MDC_JWT_PREVIOUS_SECRETS=mdc-k1:replace-with-previous-32-byte-plus-secret
MDC_OAUTH2_ISSUER=https://mdc.example.com:18443
MDC_ALLOWED_ORIGIN_PATTERNS=https://mdc.example.com:18443
MDC_AES_KEY=replace-with-32-char-aes-key
MDC_AES_ACTIVE_KEY_VERSION=v2
MDC_AES_PREVIOUS_KEYS=v1:replace-with-previous-32-char-aes-key
