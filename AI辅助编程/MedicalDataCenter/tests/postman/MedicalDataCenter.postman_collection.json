    },
    {
      "name": "Open API - Medications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{openApiToken}}"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-openapi-medications"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/open-api/v1/medications?patientCode=P2026001&drugName=阿司匹林&startDate=2026-05-01&endDate=2026-05-31",
          "host": ["{{gatewayUrl}}"],
